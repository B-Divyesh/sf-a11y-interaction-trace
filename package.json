{
  "name": "a11y-interaction-trace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config vite.site.config.ts && node scripts/stage-download.mjs",
    "build": "npm run build:site",
    "test": "vitest run",
    "test:claims": "npm run build && playwright test",
    "test:a11y": "playwright test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.2",
    "playwright": "1.58.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2",
    "wxt": "^0.21.4"
  }
}
